rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedReceipt() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/jpeg|image/png|image/webp|application/pdf');
    }

    match /jobs/{jobId}/expenses/{expenseId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isAllowedReceipt();
      allow delete: if isSignedIn();
    }

    match /employees/{employeeId}/profile/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/jpeg|image/png|image/webp');
      allow delete: if isSignedIn();
    }

    match /receipts/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /profiles/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
